# Sicherheits- und Auslieferungseinstellungen für den eigenen Webspace.
# Auf GitHub Pages wirkungslos — dort greifen die <meta>-Angaben in den Seiten.

<IfModule mod_headers.c>
  # Erzwingt, was die Seite inhaltlich verspricht: nichts von Dritten.
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"

  # Schriften ein Jahr vorhalten, HTML nie
  <FilesMatch "\.(woff2|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml application/xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Immer verschlüsselt
  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Verzeichnisauflistung aus
Options -Indexes

ErrorDocument 404 /index.html

# ═══ Schutz der Anbieterkennzeichnung ══════════════════════════════════
# Die Anschrift im Impressum muss auf der Website stehen (§ 5 DDG), aber
# sie muss nicht in Suchindizes und Adressdatenbanken landen. Das ist der
# Unterschied zwischen "verfuegbar" und "abgesammelt" — und die Stelle,
# an der sich wirksam etwas machen laesst, ohne die Pflicht zu verletzen.

# 1) Impressum aus den Suchindizes halten. Der Meta-Tag in der Seite sagt
#    dasselbe; als Header wirkt es zusaetzlich fuer Crawler, die den
#    Seiteninhalt gar nicht erst parsen.
<Files "impressum.html">
  Header set X-Robots-Tag "noindex, follow, noarchive, nosnippet"
</Files>

# 2) Bekannte Absammler und KI-Crawler abweisen. Das ersetzt keine
#    robots.txt — es ergaenzt sie um die, die sich nicht daran halten.
#    Suchmaschinen sind bewusst NICHT dabei: Die Seite soll gefunden
#    werden, nur das Impressum nicht ausgewertet.
<IfModule mod_setenvif.c>
  SetEnvIfNoCase User-Agent "EmailCollector"      absammler
  SetEnvIfNoCase User-Agent "EmailSiphon"         absammler
  SetEnvIfNoCase User-Agent "EmailWolf"           absammler
  SetEnvIfNoCase User-Agent "ExtractorPro"        absammler
  SetEnvIfNoCase User-Agent "Harvest"             absammler
  SetEnvIfNoCase User-Agent "WebBandit"           absammler
  SetEnvIfNoCase User-Agent "WebCopier"           absammler
  SetEnvIfNoCase User-Agent "HTTrack"             absammler
  SetEnvIfNoCase User-Agent "SiteSnagger"         absammler
  SetEnvIfNoCase User-Agent "Zeus"                absammler
  SetEnvIfNoCase User-Agent "MJ12bot"             absammler
  SetEnvIfNoCase User-Agent "AhrefsBot"           absammler
  SetEnvIfNoCase User-Agent "SemrushBot"          absammler
  SetEnvIfNoCase User-Agent "DotBot"              absammler
  SetEnvIfNoCase User-Agent "DataForSeoBot"       absammler
  SetEnvIfNoCase User-Agent "PetalBot"            absammler
  SetEnvIfNoCase User-Agent "^$"                  absammler

  <IfModule mod_authz_core.c>
    <RequireAll>
      Require all granted
      Require not env absammler
    </RequireAll>
  </IfModule>
</IfModule>
